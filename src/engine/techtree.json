      "setup_seconds": 1800,
      "hint": "Install Ollama (or llama.cpp / MLX on Apple silicon) and pull one model",
      "verify": {
        "command": [
          "sh",
          "-c",
          "curl -sf -m 3 http://127.0.0.1:11434/api/tags >/dev/null || curl -sf -m 3 http://127.0.0.1:8080/health >/dev/null"
        ],
        "timeout_seconds": 10
      }
    },
    {
      "id": "local-tool-calling",
      "name": "Local Tool Calling",
      "era": 2,
      "domain": "ai-ml",
      "description": "A local model that reliably emits tool calls — the threshold where local models stop being chat toys and start doing agent work",
      "requires": [
        "local-runtime"
      ],
      "detect": {
        "any": [
          "qwen",
          "hermes",
          "firefunction",
          "command-r",
          "mistral-nemo",
          "llama-?3\\.[123]",
          "gpt-oss"
        ]
      },
      "setup_seconds": 900,
      "hint": "Pull a tool-capable local model (Qwen coder, Hermes, Command-R) and verify it emits tool calls — many local models claim support and fail in practice"
    },
    {
      "id": "extended-context",
      "name": "Extended Context",
      "era": 2,
      "domain": "ai-ml",
      "description": "A model configured well past the default window, so long files and sessions survive",
      "requires": [
        "local-tool-calling"
      ],
      "detect": {
        "any": [
          "\\b(32k|64k|128k|200k|256k|1m)\\b",
          "-32768",
          "-65536",
          "-131072"
        ]
      },
      "setup_seconds": 600,
      "hint": "Set an explicit context limit per model — most runtimes silently default to 4K and truncate"
    },
    {
      "id": "model-routing",
      "name": "Model Routing",
      "era": 2,
      "domain": "ai-ml",
      "description": "More than one model available, with agents pinned to the right tier for their work",
      "requires": [
        "hosted-inference"
      ],
      "optional": [
        "local-runtime"
      ],
      "detect": {
        "any": [
          "^agent:.*"
        ],
        "min_models": 2
      },
      "setup_seconds": 600,
      "hint": "Pin cheap models to mechanical subagents and reserve the expensive tier for hard reasoning",
      "acquisition": {
        "alternatives": [
          {
            "name": "self-hosted router with managed fallbacks",
            "setup_seconds": 1200,
            "recurring_cost": "none",
            "privacy": "local",
            "note": "an OpenRouter-style gateway on your own hardware; provider failover without a per-token bill or a data boundary"
          },
          {
            "name": "hosted routing layer",
            "setup_seconds": 300,
            "recurring_cost": "per-token",
            "privacy": "hosted"
          }
        ]
      }
    },
