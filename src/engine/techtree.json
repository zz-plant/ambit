{
  "$comment": "Curated capability tree for AI agent setups. Like a Civ tech tree, this is authored content: every user gets the same tree and differs only in where they are on it. Nodes are matched against the capabilities discovered in a user's config via `detect` patterns (regex, tested against capability ids). A node with all prerequisites met but nothing detected is what `ambit near` and `ambit goal` surface as researchable next. A node may also declare a `contract.can` list: the concrete actions the capability confers. Each becomes an `act:<node>/<action>` node in its own right, so authority can be stated per action — reading a repository is not merging to its default branch — rather than only per capability.",
  "eras": {
    "1": "Foundation",
    "2": "Model Access",
    "3": "Tool Use",
    "4": "Memory",
    "5": "Autonomy",
    "6": "Assurance",
    "7": "Sovereignty"
  },
  "nodes": [
    {
      "id": "shell-execution",
      "name": "Shell Execution",
      "goal": [
        "run commands",
        "execute",
        "terminal",
        "install things",
        "automate the shell"
      ],
      "era": 1,
      "domain": "infra",
      "description": "The agent can run commands and read their output",
      "detect": {
        "any": [
          "^tool:bash$"
        ]
      },
      "setup_seconds": 0,
      "hint": "Built in to OpenCode",
      "verify": {
        "command": [
          "sh",
          "-c",
          "echo ambit"
        ],
        "timeout_seconds": 10
      },
      "authority": {
        "observe": "autonomous",
        "execute": "confirm",
        "actions": {
          "run_command": "confirm",
          "read_output": "autonomous",
          "install_package": "confirm"
        }
      },
      "contract": {
        "can": [
          "run_command",
          "read_output",
          "install_package"
        ]
      }
    },
    {
      "id": "file-editing",
      "name": "File Editing",
      "goal": [
        "edit files",
        "write code",
        "change a file",
        "read my code"
      ],
      "era": 1,
      "domain": "meta",
      "description": "The agent can read and modify files directly",
      "detect": {
        "any": [
          "^tool:edit$"
        ]
      },
      "setup_seconds": 0,
      "hint": "Built in to OpenCode",
      "verify": {
        "command": [
          "sh",
          "-c",
          "test -w ."
        ],
        "timeout_seconds": 10
      },
      "authority": {
        "observe": "autonomous",
        "execute": "autonomous",
        "actions": {
          "read_file": "autonomous",
          "write_file": "autonomous",
          "delete_file": "confirm"
        }
      },
      "contract": {
        "can": [
          "read_file",
          "write_file",
          "delete_file"
        ]
      }
    },
    {
      "id": "code-intelligence",
      "name": "Code Intelligence",
      "era": 1,
      "domain": "quality",
      "description": "Language-server diagnostics, so the agent sees errors as an IDE would",
      "requires": [
        "file-editing"
      ],
      "detect": {
        "any": [
          "^tool:lsp$"
        ]
      },
      "setup_seconds": 120,
      "hint": "Enable LSP for the languages you work in",
      "verify": {
        "command": [
          "sh",
          "-c",
          "command -v tsc || command -v pyright || command -v gopls"
        ],
        "timeout_seconds": 10
      }
    },
    {
      "id": "version-control",
      "name": "Version Control",
      "goal": [
        "git",
        "version control",
        "commit",
        "pull request",
        "branch"
      ],
      "era": 1,
      "domain": "devops",
      "description": "Git operations, so agent work is reviewable and revertible",
      "requires": [
        "shell-execution"
      ],
      "detect": {
        "any": [
          "\\bgit\\b",
          "github",
          "gitlab"
        ]
      },
      "setup_seconds": 300,
      "hint": "Add a git or GitHub MCP server so the agent can branch, diff, and open PRs",
      "verify": {
        "command": [
          "git",
          "--version"
        ],
        "timeout_seconds": 10
      },
      "authority": {
        "observe": "autonomous",
        "execute": "confirm",
        "actions": {
          "read_repository": "autonomous",
          "commit_changes": "autonomous",
          "push_branch": "confirm",
          "merge_to_default": "confirm"
        }
      },
      "contract": {
        "can": [
          "read_repository",
          {
            "id": "commit_changes",
            "verify": {
              "command": [
                "git",
                "diff",
                "--exit-code"
              ],
              "timeout_seconds": 10
            }
          },
          "push_branch",
          "merge_to_default"
        ]
      }
    },
    {
      "id": "hosted-inference",
      "name": "Hosted Inference",
      "goal": [
        "use a hosted model",
        "api access",
        "claude api",
        "gpt",
        "cloud model"
      ],
      "era": 2,
      "domain": "ai-ml",
      "description": "At least one hosted model provider configured",
      "requires": [
        "shell-execution"
      ],
      "detect": {
        "any": [
          "^provider:(?!local)",
          "^model:(?!local)"
        ]
      },
      "setup_seconds": 300,
      "hint": "Configure a provider with an API key"
    },
    {
      "id": "local-runtime",
      "name": "Local Runtime",
      "goal": [
        "run a local model",
        "ollama",
        "offline model",
        "private inference",
        "llama.cpp"
      ],
      "era": 2,
      "domain": "ai-ml",
      "description": "A model server running on your own hardware — Ollama, llama.cpp, MLX, or LiteRT",
