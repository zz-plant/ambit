{
  "name": "capability-graph",
  "version": "0.3.0",
  "private": false,
  "description": "A capability graph for your OpenCode toolchain",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"bun run server\" \"vite\"",
    "build": "bun run typecheck && vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "start": "NODE_ENV=production bun run server",
    "server": "bun run server.ts",
    "assets:check": "bun run scripts/check-assets.ts",
    "assets:generate": "bun run scripts/generate-scenes.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.0",
    "@react-three/postprocessing": "^2.16.0",
    "date-fns": "^2.29.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.168.0",
    "zustand": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-react": "^4",
    "concurrently": "^8.2.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0"
  },
  "bin": "./cli.js",
  "keywords": [
    "opencode",
    "toolchain",
    "capability-graph",
    "tech-tree"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zz-plant/capability-graph.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
