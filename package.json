{
  "name": "ambit-cli",
  "version": "0.4.0",
  "private": false,
  "description": "A capability model and planning layer for personal agent infrastructure",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"bun run server\" \"vite\"",
    "build": "bun run typecheck && vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "start": "NODE_ENV=production bun run server",
    "server": "bun run server.ts",
    "assets:check": "bun run scripts/check-assets.ts",
    "assets:generate": "bun run scripts/generate-scenes.ts"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.3.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4",
    "concurrently": "^8.2.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0"
  },
  "license": "MIT",
  "bin": {
  "ambit": "./cli.js"
},
"files": [
  "cli.js",
  "src/engine",
  "src/mcp",
  "src/shared",
  "plugins"
],
"keywords": [
  "capability-graph",
  "agent-infrastructure",
  "mcp",
  "mcp-server",
  "local-llm",
  "dependency-graph",
  "planning",
  "developer-tools"
],
"repository": {
  "type": "git",
  "url": "https://github.com/zz-plant/ambit.git"
},
"publishConfig": {
  "access": "public"
}
}
