{
  "name": "ambit-cli",
  "version": "0.5.0",
  "private": false,
  "description": "What you, your agents, and your machines can jointly do — and where your own time is going.",
  "mcpName": "io.github.zz-plant/ambit",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run server\" \"vite\"",
    "build": "npm run typecheck && vite build && npm run docs:build",
    "docs:build": "node --experimental-strip-types scripts/build-docs.ts",
    "test": "vitest run",
    "demo:incident": "python3 scripts/demo_incident_trace.py",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "start": "NODE_ENV=production npm run server",
    "server": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/server/api.ts",
    "build:cli": "rm -rf dist-cli && tsc -p tsconfig.publish.json && cp src/engine/schema.sql src/engine/techtree.json dist-cli/engine/ && cp src/shared/concepts.json dist-cli/shared/",
    "prepublishOnly": "npm run build:cli",
    "prepack": "npm run build:cli && vite build",
    "assets:check": "node --experimental-strip-types scripts/check-assets.ts",
    "prose:check": "node --experimental-strip-types scripts/check-prose.ts",
    "assets:generate": "node --experimental-strip-types scripts/generate-scenes.ts",
    "assets:hero": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/record-hero-gif.ts",
    "demo:generate": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/generate-demo-data.ts",
    "demo:check": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/check-demo-data.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:examples": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/capture-doc-examples.ts",
    "docs:examples:check": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/capture-doc-examples.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "license": "MIT",
  "bin": {
    "ambit": "./cli.js"
  },
  "files": [
    "cli.js",
    "dist-cli",
    "plugins",
    "dist/index.html",
    "dist/assets",
    "dist/favicon.svg",
    "dist/apple-touch-icon.png"
  ],
  "keywords": [
    "ai-agents",
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "claude-code",
    "cursor",
    "opencode",
    "windsurf",
    "claude-desktop",
    "gemini-cli",
    "codex-cli",
    "developer-tools",
    "agent-infrastructure",
    "capability-graph",
    "dependency-graph",
    "ai-governance",
    "human-in-the-loop",
    "audit-log",
    "cli",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zz-plant/ambit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/zz-plant/ambit#readme",
  "bugs": {
    "url": "https://github.com/zz-plant/ambit/issues"
  }
}
