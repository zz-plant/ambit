    "three": "^0.168.0",
    "zustand": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-react": "^4",
