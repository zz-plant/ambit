{
  "name": "ambit-cli",
  "version": "0.4.1",
  "private": false,
  "description": "The meta-MCP capability graph for AI agent environments",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run server\" \"vite\"",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "demo:incident": "python3 scripts/demo_incident_trace.py",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "start": "NODE_ENV=production npm run server",
    "server": "node --experimental-sqlite --disable-warning=ExperimentalWarning server.ts",
    "build:cli": "rm -rf dist-cli && tsc -p tsconfig.publish.json && cp src/engine/schema.sql src/engine/techtree.json dist-cli/engine/ && cp src/shared/concepts.json dist-cli/shared/",
    "prepublishOnly": "npm run build:cli",
    "prepack": "npm run build:cli",
    "assets:check": "node --experimental-strip-types scripts/check-assets.ts",
    "assets:generate": "node --experimental-strip-types scripts/generate-scenes.ts",
    "assets:hero": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/record-hero-gif.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:watch": "vitest",
    "docs:examples": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/capture-readme-examples.ts",
    "docs:examples:check": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/capture-readme-examples.ts --check",
    "assets:demo-tree": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/generate-demo-tree.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^8.2.0",
    "react": "^18.2.0",
    "react-dom": "^19.2.8",
    "typescript": "^5.4.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0",
    "zustand": "^4.3.6"
  },
  "license": "MIT",
  "bin": {
    "ambit": "./cli.js"
  },
  "files": [
    "cli.js",
    "dist-cli",
    "plugins"
  ],
  "keywords": [
    "capability-graph",
    "agent-infrastructure",
    "mcp",
    "mcp-server",
    "meta-mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "claude-code",
    "cursor",
    "windsurf",
    "opencode",
    "local-llm",
    "dependency-graph",
    "planning",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zz-plant/ambit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/zz-plant/ambit#readme",
  "bugs": {
    "url": "https://github.com/zz-plant/ambit/issues"
  }
}
