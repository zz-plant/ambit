{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.zz-plant/ambit",
  "description": "Capability graph of your agent stack: what works, what breaks downstream, and what to set up next.",
  "repository": {
    "url": "https://github.com/zz-plant/ambit",
    "source": "github"
  },
  "version": "0.4.1",
  "websiteUrl": "https://zz-plant.github.io/ambit/",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "ambit-cli",
      "version": "0.4.1",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "valueHint": "mcp",
          "description": "Run the MCP server over stdio instead of the terminal CLI"
        }
      ]
    }
  ]
}
