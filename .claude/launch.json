{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ambit-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "ambit-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4187",
        "--strictPort"
      ],
      "port": 4187
    },
    {
      "name": "ambit-web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AMBIT_API_PORT=3011",
        "npx",
        "vite",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "ambit-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AMBIT_API_PORT=3011",
        "node",
        "--experimental-sqlite",
        "--disable-warning=ExperimentalWarning",
        "src/server/api.ts"
      ],
      "port": 3011
    }
  ]
}
