node_modules/
dist/
dist-cli/
.DS_Store

# SQLite runtime files — the graph database is generated by ./bootstrap.sh
# and holds the local toolchain inventory; it must not be committed.
*.db
*.db-shm
*.db-wal

# Secrets
.env

# Build and test output
output/
coverage/
*.log

# Tooling scratch. Everything here is a transcript of a local run, not source.
.cmux/
.opencode/
.sisyphus/
.codex/
.agent/
.claude/*
# …except the dev-server config. That is project setup, not local scratch:
# it is what a preview launcher resolves "ambit-dev" against. It was already
# committed, but as a file the ignore rules also excluded — a state where
# `git add` on a sibling silently does nothing and no one finds out why. An
# excluded directory cannot have children re-included, hence `.claude/*`.
!.claude/launch.json
.wrangler/
.playwright-mcp/
.playwright-cli/
.pytest_cache/
__pycache__/
scratch/
.idea/
.vscode/
